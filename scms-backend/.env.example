# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของเครื่อง/เซิร์ฟเวอร์ PostgreSQL ของคุณ

PGHOST=localhost
PGPORT=5432
PGDATABASE=issue_report_system
PGUSER=postgres
PGPASSWORD=your_password_here

# พอร์ตที่ backend API จะรัน
PORT=4000

# โดเมนของ frontend ที่อนุญาตให้เรียก API นี้ (คั่นด้วย , ได้หลายโดเมน)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
